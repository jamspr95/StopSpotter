# Copy this file to .env.local (gitignored) for local development, or set
# these as GitHub Actions repo secrets for the deployed build — see
# docs/SETUP.md. Leaving them unset runs the app in local-only mode: no
# backend, no persistence beyond this browser's localStorage, same as
# Milestone 1's prototype.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shows the "Continue with Google/Apple/Facebook" buttons on the sign-up
# screen. Leave unset (or false) until at least one provider is actually
# configured in the Supabase dashboard — see docs/SETUP.md §6 — otherwise
# tapping one just fails with a provider-not-enabled error.
VITE_SSO_ENABLED=

# Admin-only: a sharper satellite "profile picture" + Street View on the
# swipe-review and stop-detail screens (src/lib/satelliteImage.ts,
# src/components/SiteExplorer.tsx) — see docs/SETUP.md §13. Leave unset
# and both fall back to the free Esri satellite layer already used
# elsewhere (no Street View, since there's no free equivalent of that).
# MUST be restricted to your deployed domain (HTTP referrer restriction)
# in the Google Cloud Console — this ships in the client bundle like any
# VITE_ variable, and an unrestricted key is a billing-abuse risk, not
# just an exposed secret the way the Supabase anon key safely is.
VITE_GOOGLE_MAPS_API_KEY=
