# Copy this file to .env.local (gitignored) for local development, or set
# these as GitHub Actions repo secrets for the deployed build — see
# docs/SETUP.md. Leaving them unset runs the app in local-only mode: no
# backend, no persistence beyond this browser's localStorage, same as
# Milestone 1's prototype.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shows the "Continue with Google/Apple/Facebook" buttons on the sign-up
# screen. Leave unset (or false) until at least one provider is actually
# configured in the Supabase dashboard — see docs/SETUP.md §6 — otherwise
# tapping one just fails with a provider-not-enabled error.
VITE_SSO_ENABLED=
